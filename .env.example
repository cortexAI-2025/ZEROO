# Copier ce fichier en `.env.local` (ignoré par git) et renseigner les valeurs.
# Seules les variables EXPO_PUBLIC_* sont embarquées dans l'app : n'y mettez jamais de secret.

# --- Supabase -----------------------------------------------------------------
# En local : valeurs affichées par `npx supabase start` (API_URL et PUBLISHABLE_KEY/ANON_KEY).
# Sur un téléphone physique, remplacez 127.0.0.1 par l'IP de votre ordinateur sur le réseau.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe (clé PUBLIABLE uniquement, pk_test_… en développement) -------------
# Feuille de paiement dans l'app mobile. Sur le web, le paiement passe par Stripe Checkout.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Facultatif : URL des Edge Functions si elles ne sont pas servies par Supabase
# (défaut : <EXPO_PUBLIC_SUPABASE_URL>/functions/v1).
EXPO_PUBLIC_FUNCTIONS_URL=

# --- Notifications push --------------------------------------------------------
# Identifiant du projet EAS, affiché par `npx eas-cli init` (lu au build, pas secret).
EAS_PROJECT_ID=

# --- Connexion Google / Apple sur le web (app.zeroo.online) -------------------
# Fournisseurs activés dans Supabase > Authentication > Providers (défaut : google,apple).
# Laisser vide un fournisseur non configuré pour masquer son bouton, ex. « google ».
EXPO_PUBLIC_OAUTH_PROVIDERS=google,apple

# --- Google Sign-In (facultatif, nécessite un build de développement) --------
# IDs client OAuth créés dans Google Cloud Console (type « Web » et type « iOS »).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# ID client iOS inversé, ex. com.googleusercontent.apps.1234-abcd
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# --- Secrets serveur : voir supabase/functions/.env.example ---------------------
# Ils ne doivent jamais être préfixés par EXPO_PUBLIC_ ni se trouver dans ce fichier.
