# Secrets des Edge Functions. En local : copier en supabase/functions/.env (ignoré par git)
# puis `npx supabase functions serve --env-file supabase/functions/.env`.
# En production : `npx supabase secrets set NOM=valeur …` (jamais dans le dépôt).
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement par Supabase.

# Clé secrète du compte Stripe de la plateforme Zéroo (sk_test_… en développement).
STRIPE_SECRET_KEY=
# Secrets de signature des deux webhooks (voir README, « Configurer Stripe »).
# En local avec `stripe listen`, le même secret whsec_… sert aux deux.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Prix récurrent « Zéroo Pro » à 9,99 € TTC par mois, taxes incluses dans le prix (price_…).
STRIPE_SUBSCRIPTION_PRICE_ID=
# Taux de TVA « TVA 20 % », France, inclus dans le prix (txr_…) : détail HT / TVA sur les factures.
STRIPE_TAX_RATE_ID=
# URL de l'app web (retours de Stripe). En local : http://localhost:8081
APP_WEB_URL=https://zeroo.fr
# Secret partagé avec pg_cron pour expire-orders (chaîne aléatoire, ex. `openssl rand -hex 32`).
CRON_SECRET=
# Délai de réponse du commerçant avant expiration automatique (minutes).
ORDER_ACCEPT_TIMEOUT_MINUTES=10
# Clé Google Maps Platform, API Routes activée (« Je pars maintenant »). Sans clé, le
# trajet est estimé à partir de la distance.
GOOGLE_ROUTES_API_KEY=
# Facultatif : jeton d'accès Expo si la « sécurité renforcée des push » est activée.
EXPO_ACCESS_TOKEN=

# Tests uniquement : services simulés (stripe-mock, faux Expo Push et Google Routes).
# STRIPE_API_BASE=http://localhost:12111
# EXPO_PUSH_URL=http://localhost:54500/push
# GOOGLE_ROUTES_URL=http://localhost:54501/routes
